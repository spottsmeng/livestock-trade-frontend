{
  "$description": "Single source of truth for every colour, spacing, radius and font-size value in the product (PRD §15.1). Three tiers: primitive (raw values, no meaning), semantic (meaning, theme-aware — light/dark/yard), component (per-component, references semantic only). Leaf tokens use the W3C Design Tokens $value/$type shape; semantic/component tokens reference primitives with {group.token} aliasing. Themes are organised as sibling sets under `semantic`, each only overriding what differs from `light`.",

  "primitive": {
    "color": {
      "neutral": {
        "0": { "$type": "color", "$value": "#ffffff" },
        "50": { "$type": "color", "$value": "#f8f8f8" },
        "100": { "$type": "color", "$value": "#f0f0f1" },
        "200": { "$type": "color", "$value": "#e2e2e4" },
        "300": { "$type": "color", "$value": "#c8c8cc" },
        "400": { "$type": "color", "$value": "#9a9aa1" },
        "500": { "$type": "color", "$value": "#6f6f78" },
        "600": { "$type": "color", "$value": "#54545c" },
        "700": { "$type": "color", "$value": "#3d3d43" },
        "800": { "$type": "color", "$value": "#26262a" },
        "900": { "$type": "color", "$value": "#18181b" },
        "950": { "$type": "color", "$value": "#0e0e10" },
        "1000": { "$type": "color", "$value": "#000000" }
      },
      "green": {
        "50": { "$type": "color", "$value": "#f0faf3" },
        "100": { "$type": "color", "$value": "#d9f2e0" },
        "500": { "$type": "color", "$value": "#1f9d55" },
        "600": { "$type": "color", "$value": "#18803f" },
        "700": { "$type": "color", "$value": "#136531" },
        "900": { "$type": "color", "$value": "#0a3a1c" }
      },
      "amber": {
        "50": { "$type": "color", "$value": "#fdf6ec" },
        "100": { "$type": "color", "$value": "#faeaca" },
        "500": { "$type": "color", "$value": "#c98a12" },
        "600": { "$type": "color", "$value": "#a66f0c" },
        "700": { "$type": "color", "$value": "#7d5409" },
        "900": { "$type": "color", "$value": "#4a3105" }
      },
      "red": {
        "50": { "$type": "color", "$value": "#fdf0f0" },
        "100": { "$type": "color", "$value": "#f8d7d7" },
        "500": { "$type": "color", "$value": "#c0362f" },
        "600": { "$type": "color", "$value": "#9e2b25" },
        "700": { "$type": "color", "$value": "#7a211c" },
        "900": { "$type": "color", "$value": "#451410" }
      },
      "blue": {
        "50": { "$type": "color", "$value": "#eef4fd" },
        "100": { "$type": "color", "$value": "#d3e4fa" },
        "500": { "$type": "color", "$value": "#1c63d6" },
        "600": { "$type": "color", "$value": "#1650ab" },
        "700": { "$type": "color", "$value": "#123f85" },
        "900": { "$type": "color", "$value": "#0a2650" }
      }
    },
    "space": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "24": { "$type": "dimension", "$value": "96px" },
      "32": { "$type": "dimension", "$value": "128px" },
      "48": { "$type": "dimension", "$value": "192px" },
      "64": { "$type": "dimension", "$value": "256px" }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0px" },
      "sm": { "$type": "dimension", "$value": "4px" },
      "md": { "$type": "dimension", "$value": "8px" },
      "lg": { "$type": "dimension", "$value": "12px" },
      "xl": { "$type": "dimension", "$value": "16px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "font": {
      "size": {
        "xs": { "$type": "dimension", "$value": "12px" },
        "sm": { "$type": "dimension", "$value": "14px" },
        "base": { "$type": "dimension", "$value": "16px" },
        "lg": { "$type": "dimension", "$value": "18px" },
        "xl": { "$type": "dimension", "$value": "20px" },
        "2xl": { "$type": "dimension", "$value": "24px" },
        "3xl": { "$type": "dimension", "$value": "30px" },
        "4xl": { "$type": "dimension", "$value": "36px" },
        "5xl": { "$type": "dimension", "$value": "48px" },
        "6xl": { "$type": "dimension", "$value": "60px" }
      },
      "weight": {
        "regular": { "$type": "number", "$value": 400 },
        "medium": { "$type": "number", "$value": 500 },
        "semibold": { "$type": "number", "$value": 600 },
        "bold": { "$type": "number", "$value": 700 }
      }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0.2, 1] },
      "decelerate": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
      "accelerate": { "$type": "cubicBezier", "$value": [0.2, 0, 1, 1] }
    }
  },

  "semantic": {
    "light": {
      "color": {
        "bg": {
          "canvas": { "$type": "color", "$value": "{primitive.color.neutral.50}" },
          "surface": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
          "raised": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
          "sunken": { "$type": "color", "$value": "{primitive.color.neutral.100}" },
          "overlay": { "$type": "color", "$value": "rgba(14,14,16,0.4)" }
        },
        "fg": {
          "primary": { "$type": "color", "$value": "{primitive.color.neutral.950}" },
          "secondary": { "$type": "color", "$value": "{primitive.color.neutral.600}" },
          "tertiary": { "$type": "color", "$value": "{primitive.color.neutral.500}" },
          "inverse": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
          "disabled": { "$type": "color", "$value": "{primitive.color.neutral.400}" }
        },
        "border": {
          "subtle": { "$type": "color", "$value": "{primitive.color.neutral.200}" },
          "default": { "$type": "color", "$value": "{primitive.color.neutral.300}" },
          "strong": { "$type": "color", "$value": "{primitive.color.neutral.500}" },
          "focus": { "$type": "color", "$value": "{primitive.color.blue.500}" }
        },
        "accent": {
          "default": { "$type": "color", "$value": "{primitive.color.blue.600}" },
          "hover": { "$type": "color", "$value": "{primitive.color.blue.700}" },
          "active": { "$type": "color", "$value": "{primitive.color.blue.900}" },
          "subtle": { "$type": "color", "$value": "{primitive.color.blue.50}" },
          "fg": { "$type": "color", "$value": "{primitive.color.neutral.0}" }
        },
        "status": {
          "pass": {
            "bg": { "$type": "color", "$value": "{primitive.color.green.50}" },
            "fg": { "$type": "color", "$value": "{primitive.color.green.700}" },
            "border": { "$type": "color", "$value": "{primitive.color.green.500}" }
          },
          "close": {
            "bg": { "$type": "color", "$value": "{primitive.color.amber.50}" },
            "fg": { "$type": "color", "$value": "{primitive.color.amber.700}" },
            "border": { "$type": "color", "$value": "{primitive.color.amber.500}" }
          },
          "breach": {
            "bg": { "$type": "color", "$value": "{primitive.color.red.50}" },
            "fg": { "$type": "color", "$value": "{primitive.color.red.700}" },
            "border": { "$type": "color", "$value": "{primitive.color.red.500}" }
          },
          "info": { "$type": "color", "$value": "{primitive.color.blue.600}" },
          "warning": { "$type": "color", "$value": "{primitive.color.amber.600}" },
          "danger": { "$type": "color", "$value": "{primitive.color.red.600}" }
        }
      },
      "elevation": {
        "0": { "$type": "shadow", "$value": "none" },
        "1": { "$type": "shadow", "$value": "0 1px 2px rgba(14,14,16,0.06)" },
        "2": { "$type": "shadow", "$value": "0 2px 8px rgba(14,14,16,0.10)" },
        "3": { "$type": "shadow", "$value": "0 8px 24px rgba(14,14,16,0.16)" }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{primitive.color.blue.500}" }
      }
    },

    "dark": {
      "$comment": "Only tokens that differ from light. Applies under prefers-color-scheme:dark (no explicit choice) AND [data-theme=dark] (explicit choice wins both directions).",
      "color": {
        "bg": {
          "canvas": { "$type": "color", "$value": "{primitive.color.neutral.950}" },
          "surface": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
          "raised": { "$type": "color", "$value": "{primitive.color.neutral.800}" },
          "sunken": { "$type": "color", "$value": "{primitive.color.neutral.1000}" },
          "overlay": { "$type": "color", "$value": "rgba(0,0,0,0.6)" }
        },
        "fg": {
          "primary": { "$type": "color", "$value": "{primitive.color.neutral.50}" },
          "secondary": { "$type": "color", "$value": "{primitive.color.neutral.300}" },
          "tertiary": { "$type": "color", "$value": "{primitive.color.neutral.400}" },
          "inverse": { "$type": "color", "$value": "{primitive.color.neutral.950}" },
          "disabled": { "$type": "color", "$value": "{primitive.color.neutral.600}" }
        },
        "border": {
          "subtle": { "$type": "color", "$value": "{primitive.color.neutral.800}" },
          "default": { "$type": "color", "$value": "{primitive.color.neutral.700}" },
          "strong": { "$type": "color", "$value": "{primitive.color.neutral.500}" },
          "focus": { "$type": "color", "$value": "{primitive.color.blue.500}" }
        },
        "accent": {
          "default": { "$type": "color", "$value": "{primitive.color.blue.500}" },
          "hover": { "$type": "color", "$value": "{primitive.color.blue.600}" },
          "active": { "$type": "color", "$value": "{primitive.color.blue.100}" },
          "subtle": { "$type": "color", "$value": "{primitive.color.blue.900}" },
          "fg": { "$type": "color", "$value": "{primitive.color.neutral.0}" }
        },
        "status": {
          "pass": {
            "bg": { "$type": "color", "$value": "{primitive.color.green.900}" },
            "fg": { "$type": "color", "$value": "{primitive.color.green.100}" },
            "border": { "$type": "color", "$value": "{primitive.color.green.500}" }
          },
          "close": {
            "bg": { "$type": "color", "$value": "{primitive.color.amber.900}" },
            "fg": { "$type": "color", "$value": "{primitive.color.amber.100}" },
            "border": { "$type": "color", "$value": "{primitive.color.amber.500}" }
          },
          "breach": {
            "bg": { "$type": "color", "$value": "{primitive.color.red.900}" },
            "fg": { "$type": "color", "$value": "{primitive.color.red.100}" },
            "border": { "$type": "color", "$value": "{primitive.color.red.500}" }
          },
          "info": { "$type": "color", "$value": "{primitive.color.blue.500}" },
          "warning": { "$type": "color", "$value": "{primitive.color.amber.500}" },
          "danger": { "$type": "color", "$value": "{primitive.color.red.500}" }
        }
      },
      "elevation": {
        "1": { "$type": "shadow", "$value": "0 1px 2px rgba(0,0,0,0.4)" },
        "2": { "$type": "shadow", "$value": "0 2px 8px rgba(0,0,0,0.5)" },
        "3": { "$type": "shadow", "$value": "0 8px 24px rgba(0,0,0,0.6)" }
      }
    },

    "yard": {
      "$comment": "PWA only (§15.2) — maximum contrast for direct sunlight. Phase 0 wires the mechanism generically so the console can also preview it; PRD scopes actual use to the buyer PWA in a later phase.",
      "color": {
        "bg": {
          "canvas": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
          "surface": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
          "raised": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
          "sunken": { "$type": "color", "$value": "{primitive.color.neutral.100}" },
          "overlay": { "$type": "color", "$value": "rgba(0,0,0,0.5)" }
        },
        "fg": {
          "primary": { "$type": "color", "$value": "{primitive.color.neutral.1000}" },
          "secondary": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
          "tertiary": { "$type": "color", "$value": "{primitive.color.neutral.700}" },
          "inverse": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
          "disabled": { "$type": "color", "$value": "{primitive.color.neutral.500}" }
        },
        "border": {
          "subtle": { "$type": "color", "$value": "{primitive.color.neutral.400}" },
          "default": { "$type": "color", "$value": "{primitive.color.neutral.700}" },
          "strong": { "$type": "color", "$value": "{primitive.color.neutral.1000}" },
          "focus": { "$type": "color", "$value": "{primitive.color.blue.700}" }
        },
        "accent": {
          "default": { "$type": "color", "$value": "{primitive.color.blue.700}" },
          "hover": { "$type": "color", "$value": "{primitive.color.blue.900}" },
          "active": { "$type": "color", "$value": "{primitive.color.blue.900}" },
          "subtle": { "$type": "color", "$value": "{primitive.color.blue.100}" },
          "fg": { "$type": "color", "$value": "{primitive.color.neutral.0}" }
        },
        "status": {
          "pass": {
            "bg": { "$type": "color", "$value": "{primitive.color.green.100}" },
            "fg": { "$type": "color", "$value": "{primitive.color.green.900}" },
            "border": { "$type": "color", "$value": "{primitive.color.green.700}" }
          },
          "close": {
            "bg": { "$type": "color", "$value": "{primitive.color.amber.100}" },
            "fg": { "$type": "color", "$value": "{primitive.color.amber.900}" },
            "border": { "$type": "color", "$value": "{primitive.color.amber.700}" }
          },
          "breach": {
            "bg": { "$type": "color", "$value": "{primitive.color.red.100}" },
            "fg": { "$type": "color", "$value": "{primitive.color.red.900}" },
            "border": { "$type": "color", "$value": "{primitive.color.red.700}" }
          },
          "info": { "$type": "color", "$value": "{primitive.color.blue.700}" },
          "warning": { "$type": "color", "$value": "{primitive.color.amber.700}" },
          "danger": { "$type": "color", "$value": "{primitive.color.red.700}" }
        }
      },
      "elevation": {
        "1": { "$type": "shadow", "$value": "0 0 0 1px rgba(0,0,0,0.2)" },
        "2": { "$type": "shadow", "$value": "0 0 0 2px rgba(0,0,0,0.3)" },
        "3": { "$type": "shadow", "$value": "0 0 0 3px rgba(0,0,0,0.4)" }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{primitive.color.blue.700}" }
      }
    }
  },

  "component": {
    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{semantic.light.color.accent.default}" },
        "fg": { "$type": "color", "$value": "{semantic.light.color.accent.fg}" }
      },
      "height": {
        "sm": { "$type": "dimension", "$value": "{primitive.space.8}" },
        "md": { "$type": "dimension", "$value": "{primitive.space.12}" },
        "lg": { "$type": "dimension", "$value": "56px" }
      }
    }
  }
}
